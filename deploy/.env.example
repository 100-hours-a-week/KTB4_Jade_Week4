# EC2의 deploy/.env로 복사해서 실제 값을 채운다. git에 올리지 않는다. (chmod 600)

# 배포할 이미지 버전 — latest 쓰지 않는다
BACKEND_TAG=v0.1.0
FRONTEND_TAG=v0.1.0

# MySQL 컨테이너 (app의 DATABASE_* 값으로도 함께 주입된다)
# 첫 배포에만 update로 두어 스키마를 만들고, 이후 validate로 되돌린다
JPA_DDL_AUTO=validate

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=banteum
MYSQL_USER=banteum
MYSQL_PASSWORD=

# JWT — openssl rand -base64 48 | tr -d '\n' 으로 새로 생성. 로컬 값 재사용 금지
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 쿠키 — HTTPS 환경이므로 secure=true. Nginx로 같은 도메인에 묶여 SAME_SITE는 Lax
# HTTP로만 접속하는 단계라면 secure=false 로 둔다. true면 쿠키가 저장되지 않아 로그인이 안 된다
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# 프론트와 같은 도메인이면 CORS는 실질적으로 쓰이지 않지만 값은 필요하다
CORS_ALLOWED_ORIGINS=https://banteum.click

# S3 / CloudFront — AWS 액세스 키는 넣지 않는다 (EC2 IAM 역할 사용)
AWS_S3_BUCKET=ktb-banteum-prod
AWS_S3_REGION=ap-northeast-2
AWS_S3_PUBLIC_BASE_URL=https://d1u8qquxeairhj.cloudfront.net
AWS_S3_PRESIGNED_EXPIRATION=5m
