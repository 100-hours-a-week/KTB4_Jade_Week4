# 백엔드 컨테이너 런타임 환경변수. chmod 600. git 에 올리지 않는다.
# DATABASE_PASSWORD 는 mysql.env 의 MYSQL_PASSWORD 와 같은 값이어야 한다.

# 첫 배포에만 update 로 두어 스키마를 만들고, 이후 validate 로 되돌린다
JPA_DDL_AUTO=validate

DATABASE_NAME=banteum
DATABASE_USER=banteum
DATABASE_PASSWORD=

# openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# HTTPS 환경이므로 secure=true. HTTP 로만 접속한다면 false 로 둔다
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

CORS_ALLOWED_ORIGINS=https://banteum.click

# AWS 액세스 키는 넣지 않는다 (EC2 IAM 역할 사용)
AWS_S3_BUCKET=ktb-banteum-prod
AWS_S3_REGION=ap-northeast-2
AWS_S3_PUBLIC_BASE_URL=https://d1u8qquxeairhj.cloudfront.net
AWS_S3_PRESIGNED_EXPIRATION=5m
